#include <iostream>
#include <cstring>

using namespace std;

struct Car {
    char model[30];
    int year;
    double price;
    char color[20];
};

int main() {
    Car cars[6] = {
        {"Audi A4", 2001, 4500, "Red"},
        {"BMW 320", 2005, 6200, "Black"},
        {"Ford Focus", 2001, 3800, "Blue"},
        {"VW Passat", 2001, 4100, "Red"},
        {"Opel Astra", 1999, 2900, "Silver"},
        {"Toyota Corolla", 2001, 5000, "Red"}
    };

    cout << "All cars:\n";
    for (int i = 0; i < 6; i++) {
        cout << cars[i].model << " | " << cars[i].year << " | " 
             << cars[i].price << "$ | " << cars[i].color << "\n";
    }

    cout << "\nFound red cars from 2001:\n";
    for (int i = 0; i < 6; i++) {
        if (cars[i].year == 2001 && strcmp(cars[i].color, "Red") == 0) {
            cout << cars[i].model << "\n";
        }
    }

    return 0;
}
