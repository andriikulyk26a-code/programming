#include <iostream>
using namespace std;

void calc(double a, char op, double b); 

int main() {
    double a, b;
    char op, again;
    do {
        cout << "Enter first operand, operation and second operand: ";
        cin >> a >> op >> b;
        calc(a, op, b);
        cout << "Do one more operation (y/n)? ";
        cin >> again;
    } while (again == 'y' || again == 'Y');
    return 0;
}

void calc(double a, char op, double b) {
    if (op == '+')
        cout << "Result is " << a + b << endl;
    else if (op == '-')
        cout << "Result is " << a - b << endl;
    else if (op == '*')
        cout << "Result is " << a * b << endl;
    else if (op == '/') {
        if (b != 0)
            cout << "Result is " << a / b << endl;
        else
            cout << "Error: division by zero" << endl;
    }
    else
        cout << "Error: unknown operation" << endl;
}
