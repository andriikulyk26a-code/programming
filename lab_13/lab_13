#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

double f(double x) {
    return cos(x * x + 1.0) - fabs(sin(2.0 * x) - 5.76);
}

int main() {
    const int i = 9;
    const double h = 0.1 * i; // 0.9

    double firstY = 0.0;
    double maxY = 0.0;
    bool isFirst = true;

    cout << fixed << setprecision(4);
    cout << "  x    |    y\n";
    cout << "-----------------\n";

    for (double x = 0.0; x <= i + 1e-9; x += h) {
        double y = f(x);
        cout << setw(6) << x << " | " << setw(8) << y << "\n";

        if (isFirst) {
            firstY = y;
            maxY = y;
            isFirst = false;
        } else {
            if (y > maxY) maxY = y;
        }
    }

    double result = fabs(maxY - firstY);

    cout << "-----------------\n";
    cout << "First y: " << firstY << "\n";
    cout << "Max y:   " << maxY << "\n";
    cout << "Result:  " << result << "\n";

    return 0;
}
