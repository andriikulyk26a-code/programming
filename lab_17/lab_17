#include <iostream>
#include <cstring>
#include <cctype>

using namespace std;

int main() {
    char str[256];
    cout << "Enter text: ";
    cin.getline(str, 256);

    char words[50][50];
    int count = 0;

    char* token = strtok(str, " \t");
    while (token != nullptr && count < 50) {
        strcpy(words[count++], token);
        token = strtok(nullptr, " \t");
    }

    bool swapped = false;
    for (int i = 0; i < count && !swapped; i++) {
        for (int j = i + 1; j < count; j++) {
            if (tolower(words[i][0]) == tolower(words[j][0])) {
                char temp[50];
                strcpy(temp, words[i]);
                strcpy(words[i], words[j]);
                strcpy(words[j], temp);

                cout << "Swapped: \"" << words[j] << "\" and \"" << words[i] << "\"\n";
                swapped = true;
                break;
            }
        }
    }

    if (!swapped) {
        cout << "No matching words found.\n";
    } else {
        cout << "Result: ";
        for (int i = 0; i < count; i++) {
            cout << words[i] << " ";
        }
        cout << "\n";
    }

    return 0;
}
