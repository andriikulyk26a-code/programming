#include <iostream>

using namespace std;

int main() {
    char source[] = "   Hello     world!    Learning   C++   strings.   ";
    char result[200];

    int i = 0, j = 0;

    while (source[i] == ' ') i++;

    while (source[i] != '\0') {
        if (source[i] != ' ') {
            result[j++] = source[i];
        }
        else {
            result[j++] = ' ';
            while (source[i] == ' ') i++;
            continue;
        }
        i++;
    }

    if (j > 0 && result[j - 1] == ' ') j--;
    result[j] = '\0';

    cout << source << "\n";
    cout << result << "\n";

    system("pause");

    return 0;
}
