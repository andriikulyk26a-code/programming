#include <iostream>

using namespace std;

typedef int Boolean;
const Boolean TRUE = 1; 
const Boolean FALSE = 0;

int main() {
    long id; 
    int a, b, c, d;

    cout << "Zalikova: ";
    cin >> id;

    cout << "Otsinky: ";
    cin >> a >> b >> c >> d;

    Boolean ok = (a >= 0 && b >= 0 && c >= 0 && d >= 0) ? TRUE : FALSE;
    if (ok == FALSE) {
        cout << "Pomylka: otsinka vidyemna!" << endl;
        return 0;
    }

    double avg = (a + b + c + d) / 4.0;

    cout << "ID: " << id << endl;
    cout << "Serednye: " << avg << endl;

    if (avg < 3) cout << "Ne skladeno" << endl;
    else if (avg < 4) cout << "Skladeno zadovilno" << endl;
    else if (avg < 5) cout << "Skladeno dobre" << endl;
    else cout << "Skladeno vidminno" << endl;

    return 0;
}
