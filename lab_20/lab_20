#include <iostream>
#include <cstdlib>
#include <ctime>
#include <iomanip>

using namespace std;

int main() {
    const int TOWNS = 6;
    const int CANDIDATES = 5;
    int votes[TOWNS][CANDIDATES];
    int var = 3;

    srand(time(NULL));

    cout << "Voting table (Towns \\ Candidates):\n";
    cout << "      ";
    for (int j = 0; j < CANDIDATES; j++) {
        cout << "Cand" << j + 1 << "  ";
    }
    cout << "\n";

    for (int i = 0; i < TOWNS; i++) {
        cout << "Town " << i + 1 << ": ";
        for (int j = 0; j < CANDIDATES; j++) {
            votes[i][j] = rand() % 500 + 50 * var;
            cout << setw(6) << votes[i][j] << " ";
        }
        cout << "\n";
    }

    int targetTown[CANDIDATES];
    for (int j = 0; j < CANDIDATES; j++) {
        targetTown[j] = votes[3][j];
    }

    int maxCand = 0, minCand = 0;
    for (int j = 1; j < CANDIDATES; j++) {
        if (targetTown[j] > targetTown[maxCand]) maxCand = j;
        if (targetTown[j] < targetTown[minCand]) minCand = j;
    }

    cout << "\nIn Town 4:\n";
    cout << "Max votes: Candidate " << maxCand + 1 << " (" << targetTown[maxCand] << " votes)\n";
    cout << "Min votes: Candidate " << minCand + 1 << " (" << targetTown[minCand] << " votes)\n";

    return 0;
}
