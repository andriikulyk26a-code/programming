#include <iostream>
#include <cstdlib>
#include <ctime>
#include <iomanip>
#include <vector>

using namespace std;

int main() {
    srand(time(nullptr));

    const int SETTLEMENTS = 6;
    const int CANDIDATES = 5;
    const int variant = 9;

    int votes[SETTLEMENTS][CANDIDATES];
    vector<int> totalCandidateVotes(CANDIDATES, 0);

    // Matrix filling: votes in range [450; 949]
    for (int k = 0; k < SETTLEMENTS; k++) {
        for (int n = 0; n < CANDIDATES; n++) {
            votes[k][n] = rand() % 500 + 50 * variant;
            totalCandidateVotes[n] += votes[k][n];
        }
    }

    // Print voting results table
    cout << "=== Voting Results Table ===\n";
    cout << "Settlement | Cand 1 | Cand 2 | Cand 3 | Cand 4 | Cand 5 |\n";
    cout << "-----------+--------+--------+--------+--------+--------|\n";

    for (int k = 0; k < SETTLEMENTS; k++) {
        cout << "Point " << setw(4) << k + 1 << " |";
        for (int n = 0; n < CANDIDATES; n++) {
            cout << setw(7) << votes[k][n] << " |";
        }
        cout << "\n";
    }

    cout << "-----------+--------+--------+--------+--------+--------|\n";
    cout << "Total (Sum)|";
    for (int n = 0; n < CANDIDATES; n++) {
        cout << setw(7) << totalCandidateVotes[n] << " |";
    }
    cout << "\n\n";

    // Task 9: Find candidates with total votes less than threshold n
    int threshold;
    cout << "Enter threshold n: ";
    if (!(cin >> threshold)) return 0;

    cout << "\nCandidates with total votes < " << threshold << ":\n";
    bool found = false;
    for (int n = 0; n < CANDIDATES; n++) {
        if (totalCandidateVotes[n] < threshold) {
            cout << "- Candidate " << n + 1 
                 << " (Total votes: " << totalCandidateVotes[n] << ")\n";
            found = true;
        }
    }

    if (!found) {
        cout << "No candidates found with votes less than " << threshold << ".\n";
    }

    return 0;
}
