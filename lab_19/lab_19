#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

double f4(double x) {
    return fabs(sin(x) / 3.12 + pow(cos(x), 2)) - 8.3 * sin(3.0 * x);
}

double f15(double x) {
    return fabs(pow(cos(x), 2) - 0.51) * sin(3.0 * x - 4.0) - 4.44;
}

int main() {
    const int ROWS = 4;
    const int COLS = 4;
    double a[ROWS][COLS];

    cout << fixed << setprecision(4);
    cout << "Matrix 4x4:\n";

    for (int k = 1; k <= ROWS; k++) {
        for (int n = 1; n <= COLS; n++) {
            a[k - 1][n - 1] = n * f4(k) + sin(k) * f15(n);
            cout << setw(10) << a[k - 1][n - 1] << " ";
        }
        cout << "\n";
    }

    double product = 1.0;
    bool found = false;

    for (int i = 0; i < ROWS; i++) {
        for (int j = 0; j < COLS; j++) {
            if (a[i][j] < -1.0 || a[i][j] > 1.0) {
                product *= a[i][j];
                found = true;
            }
        }
    }

    cout << "\nResult product: ";
    if (found) cout << product << "\n";
    else cout << "No elements found\n";

    return 0;
}
