#include <iostream>
using namespace std;

double harmonic(double x, double y); 

int main() {
    double x, y;
    cout << "Enter two numbers: ";
    cin >> x >> y;
    while (x != 0 && y != 0) {
        cout << "Harmonic mean = " << harmonic(x, y) << endl;
        cout << "Enter two numbers: ";
        cin >> x >> y;
    }
    return 0;
}

double harmonic(double x, double y) {
    return 2.0 * x * y / (x + y);
}
