#include <iostream>
using namespace std;

double toFahrenheit(double c);   // prototype

int main() {
    double c;
    cout << "Please enter the temperature in Celsius: ";
    cin >> c;
    cout << c << " degrees Celsius is " << toFahrenheit(c) << " degrees Fahrenheit" << endl;
    return 0;
}

double toFahrenheit(double c) {
    return 1.8 * c + 32.0;
}
