#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

int main() {
    const double x = 2.5, a = 1.0, b = 3.0;   // input data
    double y = 0;

    if (x <= a)
        y = pow(pow(cos(x - a), 4), 1.0 / 5);
    if (x > a && x <= b)
        y = x * x * tan(b * x);
    if (x > b)
        y = fabs(sin((a + b) * x) / (x * x - b * b));

    cout << fixed << setprecision(4);
    cout << "Input data:\n";
    cout << "x = " << setw(8) << x << "\n";
    cout << "a = " << setw(8) << a << "\n";
    cout << "b = " << setw(8) << b << "\n";
    cout << "Result:\n";
    cout << "y = " << setw(8) << y << endl;

    return 0
}
