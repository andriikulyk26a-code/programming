#include <iostream>
#include <cmath> 
#include <iomanip>

using namespace std;

int main() {
    const double a = 1.5; 
    const double b = 4.0; 
    const double x = 2.0;

    double y = 0.0;

    if (x <= a) {
        y = cbrt(pow(cos(x - a), 2));
    }
    else if (x <= b) {
        y = pow(x, 2) * tan(b * x);
    }
    else {
        y = abs((sin(a + b) * x) / (pow(x, 2) - pow(b, 2)));
    }

    cout << fixed << setprecision(2);
    cout << "a = " << a << endl;
    cout << "b = " << b << endl;
    cout << "x = " << x << endl;
    cout << "y = " << y << endl;

    return 0;
}
